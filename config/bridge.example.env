# Template only: export values into the process environment; no .env loader is included.
# If saved locally, keep it ignored by git. Do not put tokens in this file.
# PRO_BRIDGE_LEDGER must be a disposable directory, not a live production ledger.
PRO_BRIDGE_LEDGER=
PRO_BRIDGE_PROTECTED_LEDGER=
# Optional display name only. The CLI does not read a GitHub token from here.
PRO_BRIDGE_REPOSITORY=exampleowner/example-repo
PRO_BRIDGE_REMOTE=https://github.com/exampleowner/example-repo.git
